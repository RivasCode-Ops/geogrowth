# POST JSON — payload de sync (ver docs/SYNC.md)
# API local (geogrowth-sync-api): npm run dev na pasta da API
VITE_SYNC_PUSH_URL=http://127.0.0.1:8787/api/geogrowth/sync/push
# Produção: https://sua-api.com/api/geogrowth/sync/push

# Opcional — mesmo valor de SYNC_API_KEY na API (header X-API-Key)
# Em dev local pode ficar vazio se a API não exigir chave
# VITE_SYNC_API_KEY=
