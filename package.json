{
  "name": "geogrowth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5191 --strictPort",
    "preview:lan": "vite preview --host 0.0.0.0 --port 5191 --strictPort",
    "build:pages": "tsc -b && vite build --base=/geogrowth/",
    "preview:pages": "npm run build:pages && vite preview --host 127.0.0.1 --port 5191 --strictPort --base=/geogrowth/",
    "sync:api": "npm run dev --prefix ../geogrowth-sync-api"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.16.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
